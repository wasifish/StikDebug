{
  "sourceLanguage": "en",
  "strings": {
    "Enables JIT compilation for an installed app using StikDebug.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enables JIT compilation for an installed app using StikDebug."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 StikDebug 为已安装应用启用 JIT 编译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 StikDebug 為已安裝的 App 啟用 JIT 編譯。"
          }
        }
      }
    },
