    },
    "StikDebug isn't meant to attach to itself. Enabling JIT for StikDebug serves no purpose. Select the app you want to enable JIT for instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug isn't meant to attach to itself. Enabling JIT for StikDebug serves no purpose. Select the app you want to enable JIT for instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug 不应该手动附加到本体。为 StikDebug 启用 JIT 没有意义。请选择您真正需要启用 JIT 的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug 不適合附加到自己。為 StikDebug 啟用 JIT 沒有任何作用。請改選你要啟用 JIT 的 App。"
